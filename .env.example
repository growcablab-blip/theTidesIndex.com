# ---------------------------------------------------------------------------
# The Tides Index — environment template.
# Copy to .env.local for development. NEVER commit a populated .env file.
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs and metadata.
NEXT_PUBLIC_SITE_URL=https://thetidesindex.com

# --- Database -------------------------------------------------------------
# Direct Postgres connection used by migrations, seeding and server queries.
# Supabase: Project Settings -> Database -> Connection string (session pooler).
#
# For local development with nothing installed, run `npm run db:dev`. It starts
# a real Postgres (PGlite over a TCP socket), applies the migrations and seeds,
# and prints the connection string to paste here:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=

# Optional, recommended for production: a restricted role holding privileges
# only on the public_v_* views. Public pages connect with this, so a mistake in
# a query cannot read a draft record or a private column. Falls back to
# DATABASE_URL when unset.
DATABASE_URL_PUBLIC=

# --- Supabase (authentication for internal editorial users) ---------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security: used for migrations, seeding and
# system jobs only. Never expose to the browser and never use in request
# handlers that serve public pages.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional -------------------------------------------------------------
SENTRY_DSN=
