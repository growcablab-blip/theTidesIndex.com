# Environment / secrets
.env
.env.*
!.env.example

# Node / build
node_modules/
.next/
/out/
/dist/
# Anchored to the repository root. Unanchored, this rule also matched
# src/app/(public)/coverage — a real page, silently never committed, which
# 404ed in production while working locally for weeks.
/coverage/
*.log
*.tsbuildinfo
.turbo/

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# ---------------------------------------------------------------------------
# PRIVATE RESEARCH SOURCES
# Copyrighted books are local-only research inputs. Nothing under sources/
# is committed except the explanatory README. Do not weaken this rule.
# ---------------------------------------------------------------------------
sources/*
!sources/README.md
!sources/.gitkeep

# Private imports / extraction working files
data/import/*
!data/import/.gitkeep
data/private/*

# Generated publications
publishing/pdf/generated/

# Local database artefacts
*.sqlite
*.db
.pglite/

# Build artefacts of the evidence architecture, not sources.
/build/

# Screenshots and other review captures. A snapshot of a moment.
#
# Anchored. Unanchored, this matched `src/app/admin/review/` as well — and
# though git itself kept those files because they are already tracked, the
# Railway CLI applies these patterns to its own upload walk and dropped the
# directory, failing the build on a module that is present in the repository.
# Same fault as the `coverage/` rule that hid the coverage page.
/review/
